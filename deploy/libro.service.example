[Unit]
Description=LIBRO Flask App
After=network.target

[Service]
# Run as the specified user; %h expands to the user's home directory
User=pi
WorkingDirectory=%h/LIBRO
Environment="PATH=%h/LIBRO/.venv/bin"
ExecStart=%h/LIBRO/.venv/bin/python %h/LIBRO/Server.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
